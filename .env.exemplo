# Copie para .env local e substitua os placeholders; nunca versione credenciais.
# API Lixo Certo â€” exemplo de desenvolvimento
AMBIENTE_EXECUCAO=desenvolvimento
VERSAO_API=0.1.0
PORTA_GRPC=50051
# Server reflection para descoberta automÃ¡tica no Postman; manter false em produÃ§Ã£o.
HABILITAR_REFLECTION_GRPC=false

# PostgreSQL externo da aplicaÃ§Ã£o â€” uma variÃ¡vel por valor da conexÃ£o.
BANCO_DADOS_HOST=HOST_DO_POSTGRESQL
BANCO_DADOS_PORTA=5432
BANCO_DADOS_USUARIO=postgres
BANCO_DADOS_SENHA=CHANGE_ME
BANCO_DADOS_NOME=lixocerto
BANCO_DADOS_SSL=false

# Use um banco separado para testes; nÃ£o aponte testes para a base principal.
BANCO_DADOS_TESTE_HOST=HOST_DO_POSTGRESQL_TESTE
BANCO_DADOS_TESTE_PORTA=5432
BANCO_DADOS_TESTE_USUARIO=postgres
BANCO_DADOS_TESTE_SENHA=CHANGE_ME
BANCO_DADOS_TESTE_NOME=lixocerto_teste

# Redis local gerenciado por infra_lixocerto.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_TESTE_HOST=127.0.0.1
REDIS_TESTE_PORT=6379
REDIS_TESTE_PASSWORD=CHANGE_ME
REDIS_TESTE_DB=15

ORIGENS_PERMITIDAS=http://localhost:3000

# AutenticaÃ§Ã£o prÃ³pria da API. Gere valores aleatÃ³rios com pelo menos 32 caracteres.
SEGREDO_JWT=CHANGE_ME
EMISSOR_JWT=lixo-certo-api
AUDIENCIA_JWT=lixo-certo-client

# Usado para proteger e anonimizar dados da avaliação de usabilidade.
SEGREDO_HASH_PARTICIPANTE=CHANGE_ME

# Envio de e-mail transacional.
PROVEDOR_EMAIL=log
RESEND_CHAVE_API=CHANGE_ME
EMAIL_REMETENTE=nao-responda@seudominio-verificado.com
EMAIL_NOME_REMETENTE=Lixo Certo
SEGREDO_CODIGO_EMAIL=CHANGE_ME

URL_PUBLICA_FRONTEND=http://localhost:3000
CAMINHO_PROTO=contratos/lixo_certo/v1/servico_saude.proto
# Senhas das contas locais de homologação; forneça somente no ambiente do seeder.
LCR_HOMOLOGACAO_SENHA_USUARIO=CHANGE_ME
LCR_HOMOLOGACAO_SENHA_PESQUISADOR=CHANGE_ME
LCR_HOMOLOGACAO_SENHA_REVISOR=CHANGE_ME
